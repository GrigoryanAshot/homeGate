generator client {
  provider = "prisma-client-js"
}

// Neon / Vercel Postgres — set DATABASE_URL on Vercel (postgresql://…)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// App account — any email (Gmail, iCloud, Outlook, …)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]
}

/// One-time email login code
model EmailLoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/// Factory ESP / controller. Id = product/sticker number (permanent).
model Device {
  id         String   @id
  /// SHA-256 of factory secret (never store raw secret)
  secretHash String
  /// FREE | BUSY
  status     String   @default("FREE")
  /// ESP hardware id (MAC-based), set on first SoftAP+register
  chipId     String?  @unique
  /// Owner User.id (email profile)
  ownerId    String?
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Display name chosen by owner on claim
  name       String?
  /// UI animation only: "rollup" | "slide" — null until owner picks
  gateType   String?
  claimedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  shares     GateShare[]
  accessEvents GateAccessEvent[]

  @@index([status])
  @@index([ownerId])
}

/// Who opened/closed a gate — isolated per device (owner + shared controllers).
model GateAccessEvent {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// OPEN | CLOSE
  action    String
  /// Display name at the time of the action
  actorName String
  /// owner | share
  actorKind String
  /// Owner User.id when actorKind=owner
  actorUserId String?
  /// GateShare.id when actorKind=share
  shareId   String?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

/// ESP online after SoftAP Wi‑Fi, waiting for app claim to assign a sticker product.
model ChipPending {
  chipId     String   @id
  lastSeenAt DateTime @updatedAt
  createdAt  DateTime @default(now())
}

/// One-time handoff: product id + secret for ESP after owner claims sticker in the app.
model ChipBindOffer {
  chipId     String   @id
  productId  String
  secret     String
  createdAt  DateTime @default(now())
}

/// Shared access for one gate only — never mixed across devices.
model GateShare {
  id        String    @id
  deviceId  String
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name      String
  /// JSON ControllerAccessRule
  ruleJson  String
  /// Signed invite token (for resend / verify)
  token     String
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deviceId])
  @@index([deviceId, revokedAt])
}

/// SoftAP portal: email verified → one-time token ESP uses after home Wi‑Fi.
/// Never used to reassign reserved demo stickers (e.g. demo-gate-001).
model SoftApProvisionToken {
  id           String    @id @default(cuid())
  token        String    @unique
  /// One-time browser handoff → set session cookie and open the app
  handoffToken String?   @unique
  userId       String
  expiresAt    DateTime
  usedAt       DateTime?
  handoffUsedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
