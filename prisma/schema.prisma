generator client {
  provider = "prisma-client-js"
}

// Neon / Vercel Postgres — set DATABASE_URL on Vercel (postgresql://…)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// App account — any email (Gmail, iCloud, Outlook, …)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]
}

/// One-time email login code
model EmailLoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/// Factory ESP / controller. Id = product/sticker number (permanent).
model Device {
  id         String   @id
  /// SHA-256 of factory secret (never store raw secret)
  secretHash String
  /// FREE | BUSY
  status     String   @default("FREE")
  /// ESP hardware id (MAC-based), set on first SoftAP+register
  chipId     String?  @unique
  /// Owner User.id (email profile)
  ownerId    String?
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Display name chosen by owner on claim
  name       String?
  claimedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  shares     GateShare[]

  @@index([status])
  @@index([ownerId])
}

/// ESP online after SoftAP Wi‑Fi, waiting for app claim to assign a sticker product.
model ChipPending {
  chipId     String   @id
  lastSeenAt DateTime @updatedAt
  createdAt  DateTime @default(now())
}

/// One-time handoff: product id + secret for ESP after owner claims sticker in the app.
model ChipBindOffer {
  chipId     String   @id
  productId  String
  secret     String
  createdAt  DateTime @default(now())
}

/// Shared access for one gate only — never mixed across devices.
model GateShare {
  id        String    @id
  deviceId  String
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name      String
  /// JSON ControllerAccessRule
  ruleJson  String
  /// Signed invite token (for resend / verify)
  token     String
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deviceId])
  @@index([deviceId, revokedAt])
}
