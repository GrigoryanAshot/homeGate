# App URL for invite links
NEXT_PUBLIC_APP_URL=https://home-gate-seven.vercel.app

# Sign invite tokens (server-only in production — set in Vercel env)
INVITE_SECRET=change-me-to-a-long-random-string

# Default gate id when admin has not picked one (multi-gate)
NEXT_PUBLIC_DEFAULT_GATE_ID=default

# Optional topic prefix for multi-gate MQTT: home/{gateId}/command
NEXT_PUBLIC_MQTT_TOPIC_PREFIX=home
NEXT_PUBLIC_MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
NEXT_PUBLIC_MQTT_USER=your-username
NEXT_PUBLIC_MQTT_PASS=your-password
NEXT_PUBLIC_MQTT_PORT=8884
NEXT_PUBLIC_MQTT_PATH=/mqtt
NEXT_PUBLIC_MQTT_TOPIC_COMMAND=home/gate/command
NEXT_PUBLIC_MQTT_TOPIC_STATUS=home/gate/status
