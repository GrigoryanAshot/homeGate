# App URL for invite links
NEXT_PUBLIC_APP_URL=https://1234-plum-nine.vercel.app

# Sign invite tokens + session cookies (server-only in production)
INVITE_SECRET=change-me-to-a-long-random-string
AUTH_SECRET=change-me-to-another-long-random-string

# Email login codes (any address: Gmail, iCloud, Outlook, …)
# Without RESEND_API_KEY, codes are logged / shown in the UI (dev).
# RESEND_API_KEY=re_xxxx
# AUTH_EMAIL_FROM="Touch SmartGate <noreply@yourdomain.com>"

# Neon / Vercel Postgres (required on Vercel — SQLite will not work there)
# Example: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Local-only fallback while developing offline (optional):
# DATABASE_URL="file:./dev.db"

# Default gate id when admin has not picked one (multi-gate)
NEXT_PUBLIC_DEFAULT_GATE_ID=default

# Optional topic prefix for multi-gate MQTT: home/{gateId}/command
NEXT_PUBLIC_MQTT_TOPIC_PREFIX=home
NEXT_PUBLIC_MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
NEXT_PUBLIC_MQTT_USER=your-username
NEXT_PUBLIC_MQTT_PASS=your-password
NEXT_PUBLIC_MQTT_PORT=8884
NEXT_PUBLIC_MQTT_PATH=/mqtt
NEXT_PUBLIC_MQTT_TOPIC_COMMAND=home/gate/command
NEXT_PUBLIC_MQTT_TOPIC_STATUS=home/gate/status
